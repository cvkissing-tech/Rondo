{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@jean/*": [
        "src/renderer/src/vendor/jean/*"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    },
    "allowImportingTsExtensions": true
  }
}
